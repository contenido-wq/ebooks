# URL pública de la tienda, sin barra final. Se usa para la vista previa al compartir (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp con código de país, solo dígitos (ejemplo: 573001234567). Si se deja vacío, no aparece el botón.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Enlace del PDF del libro (Google Drive, "Cualquier persona con el enlace"). Debe empezar por https://.
# Sin esta variable, /gracias responde 404. Este repositorio es público: nunca pongas el enlace real en un archivo versionado.
NEXT_PUBLIC_DESCARGA_URL=
